{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factosys.local/schemas/daily-summary-create.json",
  "title": "DailySummaryCreate",
  "description": "RC — 20-diccionario-json-ubl-rc.md",
  "type": "object",
  "additionalProperties": false,
  "required": ["company_id", "reference_date"],
  "properties": {
    "company_id": { "type": "string", "format": "uuid" },
    "reference_date": { "type": "string", "format": "date" },
    "issue_date": { "type": "string", "format": "date" },
    "correlative": { "type": "integer", "minimum": 1 },
    "document_ids": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" }
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "document_id": { "type": "string", "format": "uuid" },
          "document_type": { "type": "string", "enum": ["03", "07", "08"] },
          "serie_number": { "type": "string" },
          "status": { "type": "string", "enum": ["1", "2", "3"] },
          "customer": { "type": "object", "additionalProperties": true },
          "totals": { "type": "object", "additionalProperties": true },
          "affected_document": { "type": "object", "additionalProperties": true },
          "perception": { "type": "object", "additionalProperties": true }
        }
      }
    }
  }
}
