{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factosys.local/schemas/voided-document-create.json",
  "title": "VoidedDocumentCreate",
  "description": "RA — 19-diccionario-json-ubl-ra.md",
  "type": "object",
  "additionalProperties": false,
  "required": ["company_id", "reference_date", "documents"],
  "properties": {
    "company_id": { "type": "string", "format": "uuid" },
    "reference_date": { "type": "string", "format": "date" },
    "issue_date": { "type": "string", "format": "date" },
    "correlative": { "type": "integer", "minimum": 1 },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_type", "reason"],
        "properties": {
          "line_id": { "type": "integer", "minimum": 1 },
          "document_type": { "type": "string" },
          "serie_number": { "type": "string" },
          "serie": { "type": "string" },
          "number": { "type": "integer", "minimum": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "anyOf": [
          { "required": ["serie_number"] },
          { "required": ["serie", "number"] }
        ]
      }
    }
  }
}
